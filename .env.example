OPSPILOT_ENVIRONMENT=local
OPSPILOT_RETRIEVAL_BACKEND=memory
OPSPILOT_EMBEDDING_PROVIDER=hash
OPSPILOT_EMBEDDING_MODEL=text-embedding-3-small
OPSPILOT_EMBEDDING_DIMENSIONS=1536
OPSPILOT_CORPUS_DIR=fixtures/runbooks
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_DATABASE_POOL_MIN_SIZE=1
OPSPILOT_DATABASE_POOL_MAX_SIZE=8
OPSPILOT_APPROVAL_TTL_SECONDS=900
OPSPILOT_EXECUTION_LEASE_TTL_SECONDS=30
OPSPILOT_WORKER_ID=local-opspilot-worker
# All three OIDC values are required together for authenticated /v1 routes.
OPSPILOT_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OPSPILOT_AUTH_ISSUER=https://identity.example.com/
OPSPILOT_AUTH_AUDIENCE=opspilot-api
OPSPILOT_TELEMETRY_EXPORTER=none
# OPSPILOT_OTLP_ENDPOINT=http://localhost:4318
# OPENAI_API_KEY is intentionally never committed.
